{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/jobs/:id",
      "destination": "/api/job-page"
    },
    {
      "source": "/indeed/jobs.xml",
      "destination": "/api/indeed-feed"
    },
    {
      "source": "/company",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    }
  ]
}
