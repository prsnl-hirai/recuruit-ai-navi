{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/jobs/:id",
      "destination": "/api/job-page"
    },
    {
      "source": "/indeed/jobs.xml",
      "destination": "/api/indeed-feed"
    },
    {
      "source": "/company",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/jobs",
      "destination": "/index.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/admin/subsidy-consultations",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/job-list?cron=1",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/applications?cron=interview-reminders",
      "schedule": "0 0 * * *"
    }
  ]
}
